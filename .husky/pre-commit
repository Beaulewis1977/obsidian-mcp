#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🔍 Running pre-commit quality checks..."

# Run TypeScript linting first
echo "📝 Checking TypeScript compilation..."
npm run lint
if [ $? -ne 0 ]; then
  echo "❌ TypeScript linting failed. Please fix the errors before committing."
  exit 1
fi

# Run tests
echo "🧪 Running test suite..."
npm run test -- --run
if [ $? -ne 0 ]; then
  echo "❌ Tests failed. Please fix the failing tests before committing."
  exit 1
fi

# Build to ensure everything compiles correctly
echo "🔨 Building project..."
npm run build
if [ $? -ne 0 ]; then
  echo "❌ Build failed. Please fix the build errors before committing."
  exit 1
fi

echo "✅ All quality checks passed! Ready to commit."
