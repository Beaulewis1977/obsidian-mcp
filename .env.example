# =============================================================================
# Obsidian MCP Server Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# DO NOT commit .env file to version control

# -----------------------------------------------------------------------------
# MCP Server Configuration
# -----------------------------------------------------------------------------
# Port for the MCP server (default: 13800)
MCP_PORT=13800

# Configuration file path (optional - defaults to ~/.obsidian-mcp/config.json)
# CONFIG_PATH=/path/to/your/config.json

# Log level (trace, debug, info, warn, error, fatal)
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Rate Limiting Configuration (Optional - Enabled by default)
# -----------------------------------------------------------------------------
# Enable/disable rate limiting
RATE_LIMITING_ENABLED=true

# Rate limiting backend (memory or redis)
RATE_LIMITING_BACKEND=memory

# Global rate limits (requests per minute/hour)
RATE_LIMITING_GLOBAL_RPM=1000
RATE_LIMITING_GLOBAL_RPH=10000

# Read operation limits (search, read, etc.)
RATE_LIMITING_READ_RPM=600
RATE_LIMITING_READ_RPH=6000

# Write operation limits (create, edit, delete, etc.)
RATE_LIMITING_WRITE_RPM=100
RATE_LIMITING_WRITE_RPH=1000

# Enable request queuing when limits are reached
RATE_LIMITING_QUEUE_REQUESTS=false
RATE_LIMITING_QUEUE_SIZE=100
RATE_LIMITING_QUEUE_TIMEOUT=30000

# -----------------------------------------------------------------------------
# Redis Configuration (Required if RATE_LIMITING_BACKEND=redis)
# -----------------------------------------------------------------------------
# Redis host (default: localhost)
RATE_LIMITING_REDIS_HOST=localhost

# Redis port (default: 6379)
RATE_LIMITING_REDIS_PORT=6379

# Redis password (if required)
# RATE_LIMITING_REDIS_PASSWORD=your-redis-password

# -----------------------------------------------------------------------------
# File Watching Configuration (Optional - Enabled by default)
# -----------------------------------------------------------------------------
# Enable/disable file watching
FILE_WATCHING_ENABLED=true

# -----------------------------------------------------------------------------
# AI API Keys (Optional - For CodeRabbit and development)
# -----------------------------------------------------------------------------
# OpenAI API Key (Required for CodeRabbit AI reviews)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic API Key (Optional - For Claude development)
# Get from: https://console.anthropic.com/keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Google AI API Key (Optional - For Gemini development)
# Get from: https://makersuite.google.com/app/apikey
GOOGLE_AI_API_KEY=your-google-ai-api-key-here

# -----------------------------------------------------------------------------
# CodeRabbit Configuration (Optional - For AI code reviews)
# -----------------------------------------------------------------------------
# CodeRabbit webhook secret (if using webhooks)
# CODERABBIT_WEBHOOK_SECRET=your-webhook-secret

# -----------------------------------------------------------------------------
# Vault Configuration (Optional - Can also be set in config.json)
# -----------------------------------------------------------------------------
# Default vault path (if not using config.json)
# OBSIDIAN_VAULT_PATH=/path/to/your/vault

# Obsidian API key (for REST API access - if configured)
# OBSIDIAN_API_KEY=your-obsidian-api-key

# -----------------------------------------------------------------------------
# Development Configuration
# -----------------------------------------------------------------------------
# Enable development mode (more verbose logging)
NODE_ENV=production

# Enable source maps for debugging
# NODE_OPTIONS=--enable-source-maps

# -----------------------------------------------------------------------------
# Example Complete Configuration
# -----------------------------------------------------------------------------
#
# For production with Redis rate limiting:
# RATE_LIMITING_ENABLED=true
# RATE_LIMITING_BACKEND=redis
# RATE_LIMITING_REDIS_HOST=localhost
# RATE_LIMITING_REDIS_PORT=6379
# RATE_LIMITING_REDIS_PASSWORD=your-redis-password
#
# For development with CodeRabbit:
# OPENAI_API_KEY=sk-your-openai-key
# LOG_LEVEL=debug
# FILE_WATCHING_ENABLED=true
# RATE_LIMITING_QUEUE_REQUESTS=true
#
# For minimal configuration (defaults):
# Just copy this file to .env - most features work with defaults
#
# -----------------------------------------------------------------------------

# =============================================================================
# SECURITY NOTES:
# =============================================================================
# 1. Never commit .env file to version control
# 2. Use strong, unique passwords for API keys
# 3. Rotate API keys regularly
# 4. Use environment-specific .env files (.env.development, .env.production)
# 5. Consider using a secret manager for production deployments
# =============================================================================
